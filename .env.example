# Ganti dengan URL PostgreSQL development. Neon memakai ?sslmode=require;
# untuk PostgreSQL lokal tanpa TLS, hapus parameter tersebut.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
COOKIE_SECURE=false
ADMIN_EMAIL=admin@melodytix.local
ADMIN_PASSWORD=replace-with-a-strong-local-password
